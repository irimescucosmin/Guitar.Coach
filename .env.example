# Every variable the app reads. A new one goes here as a key, never as a sentence.

# Postgres. Add ?pgbouncer=true when it points at PgBouncer in transaction mode.
DATABASE_URL=postgres://coach:coach@localhost:5432/guitar_coach
# Only for the *.db.test.ts files; they skip themselves when it is missing.
DATABASE_URL_TEST=postgres://coach:coach@localhost:5432/guitar_coach_test

# Better Auth. The secret signs sessions: at least 32 random characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# End-to-end tests against an already running server instead of starting one.
# E2E_BASE_URL=http://localhost:3000
