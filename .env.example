# Every variable the app reads. A new one goes here as a key, never as a sentence.

# Postgres. Add ?pgbouncer=true when it points at PgBouncer in transaction mode.
DATABASE_URL=postgres://coach:coach@localhost:5432/guitar_coach
# Only for the *.db.test.ts files; they skip themselves when it is missing.
DATABASE_URL_TEST=postgres://coach:coach@localhost:5432/guitar_coach_test

# Better Auth. The secret signs sessions: at least 32 random characters.
BETTER_AUTH_SECRET=
# https, not http: the browser gives the microphone only to a secure origin, so
# anything but localhost has to be served by pnpm dev:https.
BETTER_AUTH_URL=https://localhost:3000
# Other origins allowed to sign in, comma separated (the phone test address).
# BETTER_AUTH_TRUSTED_ORIGINS=https://192.168.1.20:3000

# End-to-end tests against an already running server instead of starting one.
# E2E_BASE_URL=http://localhost:3000

# Sign-in with Google: OAuth client in Google Cloud Console, redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/google. Both unset: no Google button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Sign-in with Apple: the Services ID and a client-secret JWT (ES256, from the
# .p8 key, valid up to six months). Apple refuses localhost: https domain only.
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Tests only: the e2e suite creates an account per test and needs this off.
# AUTH_RATE_LIMIT=off

# The teacher and the weekly summary: Claude Haiku through the Anthropic API,
# server side only. Without it both are off and the screens say so.
# ANTHROPIC_API_KEY=

# Shown on /terms as the address for reports and removal requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Only for `pnpm figures`: draws the Basics illustrations with Recraft (https://www.recraft.ai/profile/api). Never needed by the app.
RECRAFT_API_TOKEN=

# Only for `pnpm sung`: the sung versions of the traditional songs, with ElevenLabs' music API
# (paid plan; credits per song). The app only plays the files in public/sung/.
ELEVENLABS_API_KEY=
